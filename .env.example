# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored, never commit real credentials.

# Supabase Postgres connection string (Project Settings -> Database -> Connection string)
# Direct connection (IPv6 by default) or the session pooler URL both work.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional overrides (defaults shown). Must match the vector dimension in sql/schema.sql
# when you change the embedding model (qwen3-embedding = 4096 dims).
OLLAMA_EMBEDDING_MODEL=qwen3-embedding
OLLAMA_CHAT_MODEL=gemma3

# Context window for the chat model. Ollama's default is 2048 tokens, which is
# smaller than the expanded context we send; too small a window makes the model
# runner crash ("connection forcibly closed"). Raise it if you raise
# MAX_CONTEXT_CHARS, and lower it if the GPU runs out of memory.
OLLAMA_NUM_CTX=4096
# Maximum characters of retrieved context sent to the LLM (roughly 4 chars/token).
MAX_CONTEXT_CHARS=12000
# Retries after a crashed/timed-out Ollama call (the next call reloads the model).
OLLAMA_CHAT_RETRIES=1
# Seconds before an LLM call is abandoned and retried (0 or empty = wait forever).
OLLAMA_TIMEOUT=180
# Seconds to keep the embedding model loaded after each request. Set to 0 on
# machines where qwen3-embedding (5.6 GB) + gemma3 (4.3 GB) do not both fit in RAM.
OLLAMA_EMBEDDING_KEEP_ALIVE=300

# Optional: override the PDF used by vectorization_job/vectorize_load_vectors.py
# PDF_PATH=data/garudapuran.pdf
